---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { getPosts } from "../../posts";
import { formatDate, isoDate, SITE } from "../../site";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { title, description, date, updated, author, tags } = post.data;
const { Content } = await render(post);
const url = `${SITE.url}/blog/${post.id}/`;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: date.toISOString(),
  dateModified: (updated ?? date).toISOString(),
  author: { "@type": "Organization", name: author, url: SITE.url },
  publisher: { "@type": "Organization", name: SITE.name, url: SITE.url },
  mainEntityOfPage: url,
  image: `${SITE.url}/eudiplo.png`,
  inLanguage: "en",
};
---

<Base title={title} description={description} ogType="article" jsonLd={jsonLd}>
  <Fragment slot="head">
    <meta property="article:published_time" content={date.toISOString()} />
    {updated && <meta property="article:modified_time" content={updated.toISOString()} />}
  </Fragment>
  <article>
    <header class="page-head">
      <div class="narrow">
        <p class="crumbs"><a href="/blog/">Blog</a></p>
        <h1>{title}</h1>
        <p class="lede">{description}</p>
        <p class="post-meta" style="margin-top:22px">
          <time datetime={isoDate(date)}>{formatDate(date)}</time>
          <span>{author}</span>
          {updated && <span>Updated <time datetime={isoDate(updated)}>{formatDate(updated)}</time></span>}
          {tags.map((tag) => <a class="tag" href={`/blog/tags/${tag}/`}>{tag}</a>)}
        </p>
      </div>
    </header>
    <div class="page-sec">
      <div class="narrow">
        <div class="prose"><Content /></div>
        <p class="post-foot"><a href="/blog/">← All posts</a><a href={SITE.discord}>Discuss on Discord ↗</a></p>
      </div>
    </div>
  </article>
</Base>
