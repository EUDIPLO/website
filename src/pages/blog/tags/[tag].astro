---
import PostCard from "../../../components/PostCard.astro";
import Base from "../../../layouts/Base.astro";
import { getPosts } from "../../../posts";

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: { posts: posts.filter((post) => post.data.tags.includes(tag)) },
  }));
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<Base title={`Posts tagged "${tag}"`} description={`EUDIPLO blog posts tagged "${tag}".`}>
  <section class="page-head">
    <div class="wrap">
      <p class="crumbs"><a href="/blog/">Blog</a><span aria-hidden="true">/</span><span>Tag</span></p>
      <h1>{tag}</h1>
    </div>
  </section>
  <section class="page-sec">
    <div class="narrow">
      <ul class="post-list">{posts.map((post) => <PostCard post={post} />)}</ul>
      <p class="post-foot"><a href="/blog/">← All posts</a></p>
    </div>
  </section>
</Base>
